{
  "name": "react-router-dataflow",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "author": "Paulin Héleine",
  "description": "A tiny, fully type-safe composer for React Router loaders, actions, and route guards",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pheleine/react-router-dataflow"
  },
  "keywords": [
    "react-router",
    "react",
    "data-router",
    "loader",
    "action",
    "middleware",
    "middleware-pipeline",
    "context",
    "typescript"
  ],
  "scripts": {
    "test": "vitest --typecheck",
    "test:run": "vitest run --typecheck",
    "tsc": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsup"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^10.5.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "react-router": "^8.0.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react-router": "^8.0.0"
  }
}
