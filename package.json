{
  "name": "react-router-dataflow",
  "version": "1.1.2",
  "license": "MIT",
  "type": "module",
  "author": "Paulin Héleine",
  "description": "A tiny, fully type-safe composer for React Router loaders, actions, and route guards",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pheleine/react-router-dataflow"
  },
  "keywords": [
    "react-router",
    "react",
    "data-router",
    "loader",
    "action",
    "middleware",
    "middleware-pipeline",
    "context",
    "typescript"
  ],
  "scripts": {
    "test": "vitest --typecheck",
    "test:run": "vitest run --typecheck",
    "build": "tsup"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^25.0.3",
    "@types/react": "^18.0.0",
    "@vitest/coverage-v8": "4.0.16",
    "eslint": "^9.39.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "react-router": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "react-router": "^7.0.0"
  }
}
